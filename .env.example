# =============================================================
#  NutriVision AI - Firebase Cloud Messaging (FCM) Environment
# =============================================================
#  Copy this file to ".env" and fill in your Firebase credentials.
#  NEVER commit the real .env file or the service account JSON.
# =============================================================

# ---- Firebase Admin (SERVER-SIDE ONLY - never expose to frontend) ----
# Your Firebase project ID (found in Firebase Console > Project Settings)
FIREBASE_PROJECT_ID=your-project-id

# Absolute or relative path to the Firebase service account JSON file.
# Download it from: Firebase Console > Project Settings > Service Accounts
# > Generate new private key.  Keep this file OUTSIDE the web root if possible.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ---- Firebase Web Config (PUBLIC - safe to expose in frontend) ----
# Found in: Firebase Console > Project Settings > General > Your apps > Web app
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ---- VAPID Public Key (for Web Push) ----
# Found in: Firebase Console > Project Settings > Cloud Messaging > Web Push
FIREBASE_VAPID_PUBLIC_KEY=BPcXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---- Notification Settings ----
# Where to write delivery logs (relative to project root)
NOTIFICATION_LOG_PATH=./logs/notifications.log

# Timezone for the scheduler (meal reminders)
NOTIFICATION_TIMEZONE=Asia/Kolkata